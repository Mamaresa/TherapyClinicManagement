# Copy to backend/.env for local development. Never commit .env.
DJANGO_SECRET_KEY=dev-only-insecure-secret-key
# Restricted runtime role: used by the running app and by the test suite.
DATABASE_URL=postgres://clinic_app:app_dev_password@127.0.0.1:5432/clinic
# Owner role: owns every table; used only for migrations (DJANGO_MIGRATE=1)
# and to create the test database.
MIGRATION_DATABASE_URL=postgres://clinic_owner:owner_dev_password@127.0.0.1:5432/clinic
DB_RUNTIME_ROLE=clinic_app
